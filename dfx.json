{
  "version": 1,
  "canisters": {
    "civicchain_backend": {
      "type": "motoko",
      "main": "src/civicchain_backend/main.mo"
    },
    "civicchain_frontend": {
      "type": "assets",
      "source": ["dist/"]
    }
  },
  "networks": {
