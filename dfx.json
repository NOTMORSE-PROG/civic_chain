{
  "version": 1,
  "canisters": {
    "civicchain_backend": {
      "type": "motoko",
      "main": "src/civicchain_backend/main.mo"
    },
    "civicchain_frontend": {
      "type": "assets",
      "source": ["dist/"],
      "dependencies": ["civicchain_backend"],
      "build": ["npm run build"],
      "asset_security": {
        "policies": [
          {
            "match": "**/*",
            "type": "standard"
          }
        ],
        "disable_policy_warning": true
      }
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral"
    },
    "ic": {
      "providers": ["https://ic0.app"],
      "type": "persistent",
      "ingress_expiry": 600
    },
    "testnet": {
      "providers": ["https://ic0.testnet.dfinity.network"],
      "type": "persistent",
      "ingress_expiry": 600
    }
  },
  "default_network": "local",
  "canister-ids": {
    "backend": {
      "local": "uxrrr-q7777-77774-qaaaq-cai"
    },
    "frontend": {
      "local": "u6s2n-gx777-77774-qaaba-cai"
    }
  }
}